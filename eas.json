{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.21.0",
      "env": {
        "EXPO_PUBLIC_XMTP_ENV": "production"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_XMTP_ENV": "dev"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "uploadSourceMaps": true,
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease -x lintVitalAnalyzeRelease -x lintVitalReportRelease -x lintVitalRelease",
        "env": {
          "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a,armeabi-v7a"
        }
      }
    },
    "github": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6818129975",
        "appleTeamId": "8N3Z3WWTK7"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
